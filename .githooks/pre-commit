#!/bin/sh
# Перед каждым коммитом: номер сборки (виден внизу стартового экрана) и список файлов версии для обновления на устройствах (files.json).
n=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
d=$(date '+%d.%m %H:%M')
v="сборка $n · $d"
printf "// Номер сборки — пишется сам перед каждым коммитом (.githooks/pre-commit)\nexport const VERSION = '%s';\n" "$v" > src/version.js
{
  printf '{"version":"%s","files":["./","vendor/three.min.js","vendor/peerjs.min.js"' "$v"
  for f in src/*.js; do printf ',"%s"' "$f"; done
  printf ']}\n'
} > files.json
git add src/version.js files.json
